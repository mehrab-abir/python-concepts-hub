    "# file may not exists, in that case, handle that with 'exception'\n",
    "try:\n",
    "    with open('./sample.txt','r') as file:\n",
    "        print(file.read())\n",
    "except Exception as e:\n",
    "    print(e)\n",
    "finally:\n",
    "    print(\"File operation ended\")"
   ]
