   "source": [
    "### Lowest Number and Position"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "71238b77",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 2, 3]\n",
      "1 1\n"
     ]
    }
   ],
   "source": [
    "size = int(input(\"How many numbers: \"))\n",
    "nums = list(map(int,input().split()))\n",
    "\n",
    "lowest = nums[0]\n",
    "pos = 1\n",
    "\n",
    "for i in range(size):\n",
    "    if(nums[i] < lowest):\n",
    "        lowest = nums[i]\n",
    "        pos = i + 1\n",
    "        \n",
    "print(nums)\n",
    "        \n",
    "print(lowest, pos)\n"
   ]
  }
